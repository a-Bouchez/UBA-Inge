!classDefinition: #MarsRover category: #MarsRover!
Object subclass: #MarsRover
	instanceVariableNames: 'position heading'
	classVariableNames: ''
	poolDictionaries: ''
	category: 'MarsRover'!

!MarsRover methodsFor: 'initialization' stamp: 'HAW 7/1/2018 13:17:50'!
initializeAt: aPosition heading: aMarsRoverHeading

	position := aPosition.
	heading := aMarsRoverHeading! !


!MarsRover methodsFor: 'testing' stamp: 'HAW 7/1/2018 14:25:05'!
isAt: aPosition heading: aCardinalPoint

	^position = aPosition and: [ heading cardinalPoint = aCardinalPoint ]! !

!MarsRover methodsFor: 'testing' stamp: 'HAW 7/6/2018 18:16:51'!
isBackwardCommand: aCommand

	^aCommand = $b! !

!MarsRover methodsFor: 'testing' stamp: 'HAW 7/6/2018 18:16:19'!
isForwardCommand: aCommand

	^aCommand = $f ! !

!MarsRover methodsFor: 'testing' stamp: 'HAW 7/6/2018 18:17:51'!
isRotateLeftCommand: aCommand

	^aCommand = $l! !

!MarsRover methodsFor: 'testing' stamp: 'HAW 7/6/2018 18:17:21'!
isRotateRightCommand: aCommand

	^aCommand = $r! !


!MarsRover methodsFor: 'processing' stamp: 'HAW 6/30/2018 19:48:45'!
invalidCommandErrorDescription
	
	^'Invalid command'! !

!MarsRover methodsFor: 'processing' stamp: 'HAW 6/30/2018 19:48:26'!
process: aSequenceOfCommands

	aSequenceOfCommands do: [:aCommand | self processCommand: aCommand ]
! !

!MarsRover methodsFor: 'processing' stamp: 'HAW 7/6/2018 18:19:33'!
processCommand: aCommand

	(self isForwardCommand: aCommand) ifTrue: [ ^ self moveForward ].
	(self isBackwardCommand: aCommand) ifTrue: [ ^ self moveBackward ].
	(self isRotateRightCommand: aCommand) ifTrue: [ ^ self rotateRight ].
	(self isRotateLeftCommand: aCommand) ifTrue: [ ^ self rotateLeft ].

	self signalInvalidCommand.! !

!MarsRover methodsFor: 'processing' stamp: 'HAW 6/30/2018 19:50:26'!
signalInvalidCommand
	
	self error: self invalidCommandErrorDescription ! !


!MarsRover methodsFor: 'moving' stamp: 'HAW 10/11/2019 08:22:42'!
moveBackward
	
	position := position - heading forwardPoint ! !

!MarsRover methodsFor: 'moving' stamp: 'HAW 10/11/2019 08:21:58'!
moveForward
	
	position := position + heading forwardPoint! !


!MarsRover methodsFor: 'rotating' stamp: 'HAW 10/11/2019 08:31:55'!
rotateLeft
	
	heading := heading leftHeading! !

!MarsRover methodsFor: 'rotating' stamp: 'HAW 10/11/2019 08:32:04'!
rotateRight
	
	heading := heading rightHeading! !

"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!

!classDefinition: 'MarsRover class' category: #MarsRover!
MarsRover class
	instanceVariableNames: 'headings'!

!MarsRover class methodsFor: 'heading' stamp: 'HAW 7/2/2018 16:28:16'!
headingFor: aCardinalPoint
	
	^headings at: aCardinalPoint ifAbsent: [ self error: self invalidCardinalPointErrorDescription ]! !

!MarsRover class methodsFor: 'heading' stamp: 'HAW 7/2/2018 16:26:14'!
invalidCardinalPointErrorDescription
	
	^'Invalid cardinal point'! !


!MarsRover class methodsFor: 'instance creation' stamp: 'HAW 7/2/2018 15:19:41'!
at: aPosition heading: aCardinalPoint
	
	| newHeading |

	newHeading := self headingFor: aCardinalPoint.
	
	^self new initializeAt: aPosition heading: newHeading ! !


!MarsRover class methodsFor: 'initialization' stamp: 'HAW 7/2/2018 15:27:41'!
initialize

	self initializeHeadings! !

!MarsRover class methodsFor: 'initialization' stamp: 'HAW 10/11/2019 08:29:27'!
initializeHeadings

	headings := Dictionary new.
	
	(OrderedCollection 
		with: (MarsRoverHeading for: #North forwardWith: 0@1 )	
		with: (MarsRoverHeading for: #East forwardWith: 1@0 )
		with: (MarsRoverHeading for: #South forwardWith: 0@-1 )
		with: (MarsRoverHeading for: #West forwardWith: -1@0 ))
			do: [ :heading | headings at: heading cardinalPoint put: heading ].
			
	(headings at: #North) leftHeading: (headings at: #West) rightHeading: (headings at: #East).
	(headings at: #South) leftHeading: (headings at: #East) rightHeading: (headings at: #West).
	(headings at: #East) leftHeading: (headings at: #North) rightHeading: (headings at: #South).
	(headings at: #West) leftHeading: (headings at: #South) rightHeading: (headings at: #North).
	! !


